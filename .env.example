# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored and excluded from the Docker build context.

# --- Build-time only -------------------------------------------------------
# GitHub Personal Access Token with the read:packages scope. Required to install
# @wyre-technology/node-ninjaone from the GitHub Packages npm registry, which has
# no anonymous read even for public packages. Any GitHub account works.
# Locally you can just use: export GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# --- Required at runtime ---------------------------------------------------
# NinjaOne OAuth 2.0 client credentials.
# NinjaOne dashboard > Administration > Apps > API > add an "API Services" app
# with the Client Credentials grant type.
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=

# --- Optional --------------------------------------------------------------
# NinjaOne API region: us (default), eu, oc, ca, us2, fed
NINJAONE_REGION=us

# OAuth scopes to request. Defaults to "monitoring,management" when unset.
# Set this to match your API app's granted scopes — asking for a scope the app
# was never granted fails the token exchange with 400 invalid_scope, which makes
# every tool call fail. Monitoring-only app? Use: NINJAONE_SCOPES=monitoring
NINJAONE_SCOPES=

# Credential source: "env" reads the values above; "gateway" takes them
# per-request from X-Ninja-* headers (for hosted gateway deployments).
AUTH_MODE=env

# Host port to publish the server on (container always listens on 8080).
HOST_PORT=8080

# Log verbosity: error, warn, info (default), debug
LOG_LEVEL=info
